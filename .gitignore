# ===========================================
# .gitignore — Prevención de filtración de secretos
# ===========================================
# Archivos de entorno y credenciales (¡NUNCA subir!)
.env
.env.*
*.pem
*.key
*.p12
*.pfx
secrets.json
credentials.json

# Editores e IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
*.egg-info/
.pytest_cache/

# Dependencias
node_modules/
package-lock.json
yarn.lock

# Logs y temporales
*.log
logs/
tmp/
*.tmp

# Build / caché
dist/
build/
.cache/